{
  "name": "nebbos-document",
  "version": "1.0.0",
  "source": "founder ratification 2026-09-28; nebbos-technical-reference.pdf v14",
  "fonts": {
    "body": {
      "family": "Manrope",
      "role": "body and UI",
      "weights": [
        300,
        400,
        500,
        600,
        700
      ],
      "files": {
        "300": "fonts/manrope/Manrope-Light.ttf",
        "400": "fonts/manrope/Manrope-Regular.ttf",
        "500": "fonts/manrope/Manrope-Medium.ttf",
        "600": "fonts/manrope/Manrope-SemiBold.ttf",
        "700": "fonts/manrope/Manrope-Bold.ttf"
      },
      "license": "fonts/manrope/OFL.txt"
    },
    "mono": {
      "family": "Fira Code",
      "role": "code, pre, table cells marked mono",
      "weights": [
        400,
        500
      ],
      "files": {
        "400": "fonts/fira-code/FiraCode-Regular.ttf",
        "500": "fonts/fira-code/FiraCode-Medium.ttf"
      },
      "license": "fonts/fira-code/OFL.txt"
    },
    "wordmark": {
      "family": "Fraunces",
      "role": "the Nebbos cover wordmark only, nowhere else",
      "opticalSize": 144,
      "files": null
    },
    "pdfOverlay": {
      "family": "Helvetica",
      "role": "PDF header and footer overlay (reportlab built-in, not embedded)",
      "sizePt": 7.5,
      "files": null
    }
  },
  "color": {
    "paper": "#FFFFFF",
    "paper2": "#F7F5F1",
    "ink": "#1D1C22",
    "ink2": "#4A4952",
    "ink3": "#6B6A73",
    "accent": "#FF6B1E",
    "gold": "#9A5D2A",
    "lineSoft": "#ECE9E2",
    "line": "#D4D2CC"
  },
  "page": {
    "size": "A4",
    "margin": {
      "top": "20mm",
      "right": "18mm",
      "bottom": "22mm",
      "left": "18mm"
    },
    "marginMm": {
      "top": 20,
      "right": 18,
      "bottom": 22,
      "left": 18
    },
    "screenMaxWidthPx": 1080
  },
  "typeScale": {
    "title": {
      "sizePx": 30,
      "weight": 600
    },
    "subtitle": {
      "sizePx": 17,
      "weight": 400
    },
    "section": {
      "sizePx": 22,
      "weight": 600
    },
    "subsection": {
      "sizePx": 15,
      "weight": 600
    },
    "table": {
      "sizePx": 13
    },
    "tableHeader": {
      "sizePx": 10,
      "uppercase": true,
      "letterSpaced": true
    },
    "code": {
      "sizePx": 12
    }
  },
  "layout": {
    "cover": {
      "topBorderPx": 4,
      "markSizePx": {
        "width": 46,
        "height": 48
      },
      "wordmarkHeightPx": 30,
      "classificationLetterSpacing": "0.2em"
    },
    "sectionTitleBottomBorderPx": 2,
    "tableRowBorder": "lineSoft",
    "tableHeaderBorder": "line",
    "noteLeftBorderPt": 3,
    "codeLeftBorderPx": 3,
    "pdfHeader": {
      "offsetFromTopMm": 12,
      "ruleWidthPt": 0.4
    },
    "pdfFooter": {
      "offsetFromBottomMm": 10,
      "ruleWidthPt": 0.4
    }
  }
}
